{
  "manifest_version": 3,
  "name": "IB Circlio",
  "version": "1.0.2",
  "description": "Privacy-first local Instagram follower and following history tracker with SQLite and change detection.",
  "icons": {
    "16": "icons/ib-16.png",
    "32": "icons/ib-32.png",
    "48": "icons/ib-48.png",
    "128": "icons/ib-128.png"
  },
  "permissions": ["scripting"],
  "host_permissions": [
    "https://www.instagram.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "IB Circlio",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/ib-16.png",
      "32": "icons/ib-32.png",
      "48": "icons/ib-48.png",
      "128": "icons/ib-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "ib-circlio@xxkyser-ctrl.github.io",
      "strict_min_version": "121.0"
    }
  }
}
